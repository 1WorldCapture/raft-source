# Self-hosted web entry point: static SPA + reverse proxy to the raft server.
#
# Differences from nginx.conf (the official image config):
#   - `/api/` and `/socket.io/` are proxied to ${RAFT_SERVER_UPSTREAM}
#     (injected by the nginx:alpine envsubst template mechanism at container
#     start; only variables present in the environment are substituted, so
#     nginx's own $uri/$http_upgrade survive).
#   - The Cloudflare challenge origins stay in the CSP (harmless allowlist;
#     intranet deployments simply never load them).
# Everything else mirrors nginx.conf so static behavior is identical.
#
# Attachments up to 256 MiB (see RAFT_CLIENT_MAX_BODY in source deploys).
client_max_body_size 256m;

server {
    # Repeat at each location: local add_header disables parent inheritance.
    add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; worker-src 'self' blob:" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1000;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # API — proxied to the raft server (same-origin deployment).
    location /api/ {
        proxy_pass http://${RAFT_SERVER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    # Socket.io — WebSocket upgrade + long-poll fallback.
    location /socket.io/ {
        proxy_pass http://${RAFT_SERVER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Hashed static assets — cache immutably
    location /assets/ {
        add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; worker-src 'self' blob:" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, immutable, max-age=31536000";
        try_files $uri =404;
    }

    # Desktop compatibility is a machine-readable fixed path. Never let a
    # missing artifact fall through to index.html: Desktop must fail closed.
    location = /desktop-manifest.json {
        add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; worker-src 'self' blob:" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        default_type application/json;
        add_header Cache-Control "no-cache, must-revalidate" always;
        etag off;
        include /etc/nginx/desktop-manifest-etag.conf;
        try_files $uri @desktop_manifest_missing;
    }

    location @desktop_manifest_missing {
        add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; worker-src 'self' blob:" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 404 '{"error":"desktop_manifest_unavailable"}';
    }

    # SPA fallback — serve index.html for all non-file routes (no cache)
    location / {
        add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; worker-src 'self' blob:" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
