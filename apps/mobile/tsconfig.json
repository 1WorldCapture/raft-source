{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "@botiverse/raft-shared/src/raftRefs.ts": ["../../packages/shared/src/raftRefs.ts"],
      "@botiverse/raft-shared/src/timeFormatPreference.ts": ["../../packages/shared/src/timeFormatPreference.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
