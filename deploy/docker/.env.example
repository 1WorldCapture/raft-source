# Raft self-hosted deployment environment (phase 1).
# Copy to `.env` next to docker-compose.yml and fill in the REQUIRED values.
# Never commit the filled-in file.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Password for the bundled PostgreSQL user `raft`. Generate e.g.:
#   openssl rand -hex 24
# (hex on purpose: no URL-unsafe characters in the postgres:// DSN)
POSTGRES_PASSWORD=

# Server JWT signing secret (packages/server requires it at boot). Generate:
#   openssl rand -base64 48
JWT_SECRET=

# Public origin browsers AND Computers/daemons use to reach this stack,
# e.g. http://192.168.1.10:18443 or https://raft.internal.example:18443.
# Required: SERVER_URL / APP_URL / CORS_ORIGIN are all derived from it, and
# email links are generated with it.
RAFT_PUBLIC_ORIGIN=

# ── Optional (sensible defaults shown) ──────────────────────────────────────

# Host port the web entry point publishes. Owner's standing choice for the
# test server is 18443 (443 and 8443 are taken).
RAFT_HTTP_PORT=18443

# statement_timeout (ms) for the boot-time migration connection
# (packages/server/entrypoint.sh). Range 1000–3600000.
RAFT_MIGRATION_TIMEOUT_MS=60000

# Image references. Override when you load specific builds (see README).
# RAFT_SERVER_IMAGE=raft-source-server:dev-<sha>
# RAFT_WEB_IMAGE=raft-source-web-selfhost:dev-<sha>
