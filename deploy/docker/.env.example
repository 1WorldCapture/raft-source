# Raft self-hosted deployment environment (phase 1).
# Copy to `.env` next to docker-compose.yml and fill in the REQUIRED values.
# Never commit the filled-in file.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Password for the bundled PostgreSQL user `raft`. Generate e.g.:
#   openssl rand -hex 24
# (hex on purpose: no URL-unsafe characters in the postgres:// DSN)
POSTGRES_PASSWORD=

# Server JWT signing secret (packages/server requires it at boot). Generate:
#   openssl rand -base64 48
JWT_SECRET=

# Public origin browsers AND Computers/daemons use to reach this stack,
# e.g. http://192.168.1.10:18443 or https://raft.internal.example:18443.
# Required: SERVER_URL / APP_URL / CORS_ORIGIN are all derived from it, and
# email links are generated with it.
RAFT_PUBLIC_ORIGIN=

# ── Optional (sensible defaults shown) ──────────────────────────────────────

# Host port the web entry point publishes. Owner's standing choice for the
# test server is 18443 (443 and 8443 are taken).
RAFT_HTTP_PORT=18443

# statement_timeout (ms) for the boot-time migration connection
# (packages/server/entrypoint.sh). Range 1000–3600000.
RAFT_MIGRATION_TIMEOUT_MS=60000

# Image references. Override when you load specific builds (see README).
# RAFT_SERVER_IMAGE=raft-source-server:dev-<sha>
# RAFT_WEB_IMAGE=raft-source-web-selfhost:dev-<sha>

# Client artifacts directory (mounted into server AND web; nginx serves
# /downloads/ straight from it). Populate it with scripts/build-downloads.mjs
# from artifacts built off the SAME commit as the server image. The stack
# sets RAFT_DEPLOYMENT_MODE=private internally — see README phase-2 notes.
# ./downloads

# ── Private-mode link replacement (optional, task #7) ───────────────────────
# Official docs/legal links are hidden (docs) or kept (license/privacy) in
# private mode; set these to point at your own pages instead. Served to the
# web through /api/deployment-info.
# RAFT_PUBLIC_DOCS_URL=https://docs.internal.example
# RAFT_PUBLIC_TERMS_URL=https://internal.example/terms
# RAFT_PUBLIC_PRIVACY_URL=https://internal.example/privacy

# ── Managed MCP internal allowlist (optional, task #9) ──────────────────────
# Private mode ONLY: re-opens explicitly trusted internal networks for
# managed MCP endpoints (default: all internal ranges stay blocked, exactly
# like the official cloud). Loopback, link-local (cloud metadata),
# unspecified and multicast ranges can NEVER be allowed — such entries are
# ignored with a warning. Judgment applies to the DNS-resolved IPs and only
# qualifying addresses are used for the connection.
# RAFT_MANAGED_MCP_ALLOWED_NETWORKS=10.20.0.0/16,100.64.0.0/10
# RAFT_MANAGED_MCP_ALLOWED_HOSTS=mcp.corp.example
