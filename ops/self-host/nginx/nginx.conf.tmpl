# Standalone nginx for Raft, run in the foreground by pm2 as the deploy user (works without
# systemd). Rendered by render-nginx.sh into $RAFT_OPS_HOME/nginx/ — edit the template, not the output.
worker_processes auto;
pid run/nginx.pid;
error_log logs/error.log warn;
events { worker_connections 4096; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on; tcp_nopush on;
    server_tokens off;
    client_body_temp_path temp/client; proxy_temp_path temp/proxy;
    fastcgi_temp_path temp/fastcgi; uwsgi_temp_path temp/uwsgi; scgi_temp_path temp/scgi;
    # gz= shows the compression ratio per request ("-" = not compressed).
    log_format raft '$remote_addr [$time_iso8601] "$request" $status $body_bytes_sent gz=$gzip_ratio rt=$request_time up=$upstream_response_time';
    include raft.conf;
}
