upstream raft_server { server 127.0.0.1:@@RAFT_SERVER_PORT@@; keepalive 32; }

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

@@HTTP_SERVER@@server {
@@LISTEN@@
    server_name @@SERVER_NAME@@;
@@TLS_SETUP@@

    access_log logs/access.log raft;
    error_log  logs/error.log warn;

    root @@RAFT_WEB_CURRENT@@;
    index index.html;

    # Text-like responses only; images/video/archives are already compressed.
    gzip on; gzip_vary on; gzip_proxied any; gzip_comp_level 5; gzip_min_length 1000;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/manifest+json application/xml image/svg+xml font/ttf font/otf;

    client_max_body_size @@RAFT_CLIENT_MAX_BODY@@;

    # Everything the Vite dev proxy used to forward, plus server-only public routes.
    location ~ ^/(api|internal|socket\.io|daemon|share|\.well-known)/ { include raft-proxy.conf; }
    location = /health     { include raft-proxy.conf; }
    location = /robots.txt { include raft-proxy.conf; }

    location /assets/ {
        add_header Cache-Control "public, immutable, max-age=31536000";
        try_files $uri =404;
        # /etc/nginx/mime.types has no ttf entry; a server-level types{} block would REPLACE
        # the whole table, so set the type per location instead.
        location ~* \.ttf$ { default_type font/ttf; add_header Cache-Control "public, immutable, max-age=31536000"; try_files $uri =404; }
    }
    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /desktop-manifest.json { default_type application/json; add_header Cache-Control "no-cache, must-revalidate"; try_files $uri =404; }

    # Self-hosted Computer release files (RAFT_COMPUTER_WEB_ROOT). The root
    # manifest.json is the "latest" pointer and the install scripts are the
    # entry points, so both must always revalidate; per-version directories
    # are immutable once published (publish-computer.sh refuses divergent
    # republishes), so they cache for a year. Regex locations win over the
    # plain prefix below, which only 404s unrecognised paths (e.g. /computer/
    # itself) instead of falling through to the SPA index.
    location = /computer/manifest.json { default_type application/json; add_header Cache-Control "no-cache, must-revalidate"; alias @@RAFT_COMPUTER_WEB_ROOT@@/manifest.json; }
    location = /computer/install.sh { default_type text/plain; add_header Cache-Control "no-cache, must-revalidate"; alias @@RAFT_COMPUTER_WEB_ROOT@@/install.sh; }
    location = /computer/install.ps1 { default_type text/plain; add_header Cache-Control "no-cache, must-revalidate"; alias @@RAFT_COMPUTER_WEB_ROOT@@/install.ps1; }
    location ~ ^/computer/([0-9][^/]+/.+)$ { add_header Cache-Control "public, immutable, max-age=31536000"; alias @@RAFT_COMPUTER_WEB_ROOT@@/$1; }
    location /computer/ { return 404; }

    location / { add_header Cache-Control "no-cache"; try_files $uri $uri/ /index.html; }
}
@@REDIRECT_SERVERS@@