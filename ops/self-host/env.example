# Copy to ops/self-host/env.local (git-ignored) and fill in values for THIS machine.
# Every ops/self-host script sources that file (override the path with RAFT_OPS_ENV=/path/to/file).
# Secrets never go here — they live in packages/server/.env and the daemon key file.

# Live checkout that pm2 runs raft-server from (a normal git clone of your fork).
RAFT_ROOT=/opt/raft/source
# Git ref that is allowed to go live (see "Branches" in docs/self-hosting/source-deploy.md).
RAFT_DEPLOY_REF=origin/deploy
# Directory containing node / npx / pnpm (Node >= 24).
NODE_BIN_DIR=/opt/node-v24/bin

# Ops working area: build worktrees, backups, state, logs, rendered nginx config.
RAFT_OPS_HOME=/var/lib/raft-ops
# Web production builds are published to $RAFT_WEB_RELEASES/<sha>; nginx serves $RAFT_WEB_CURRENT.
RAFT_WEB_RELEASES=/srv/raft-web/releases
RAFT_WEB_CURRENT=/srv/raft-web/current

# Public ports nginx listens on (space separated). Clients keep using these.
RAFT_PUBLIC_PORTS="3001"
# Optional old ports that only 301-redirect to the first public port (keeps old bookmarks working
# while every page uses one origin). Example: RAFT_REDIRECT_PORTS="5173"
RAFT_REDIRECT_PORTS=""
# Internal port raft-server listens on (must match PORT in packages/server/.env; HOST should be 127.0.0.1).
RAFT_SERVER_PORT=3101
# Largest request body nginx accepts (attachments go up to 200 MiB on Pro plans).
RAFT_CLIENT_MAX_BODY=256m

# pm2 process names.
RAFT_PM2_SERVER=raft-server
RAFT_PM2_NGINX=raft-nginx
RAFT_PM2_WORKER=raft-trace-upload-worker
RAFT_PM2_DAEMON=raft-daemon

# Seconds to wait for /health after a restart before rolling back.
RAFT_HEALTH_TIMEOUT=90

# Optional: run this machine's daemon ("Computer") under the same pm2 file. Leave
# RAFT_DAEMON_KEY_FILE empty to skip it. Restarting it disconnects every agent on this machine.
RAFT_DAEMON_SERVER_URL=http://raft.example.internal:3001
RAFT_DAEMON_KEY_FILE=
RAFT_DAEMON_HOME=/home/raft/.slock

# statement_timeout (ms) for migration connections; see migrate.sh. Range 1000–3600000.
RAFT_MIGRATION_TIMEOUT_MS=60000

# Backups (backup.sh; scheduled by pm2, see ecosystem.config.cjs). The folder may hold secrets.
RAFT_BACKUP_DIR=/var/lib/raft-backups
RAFT_BACKUP_KEEP=7
# pm2 cron runs in the host's LOCAL timezone. To back up at a fixed UTC hour, fire hourly and
# let backup.sh skip other hours. Empty RAFT_BACKUP_CRON = no scheduled backup.
RAFT_BACKUP_CRON="0 * * * *"
RAFT_BACKUP_UTC_HOUR=21
# Extra files to include in secrets.tar.gz (space separated, relative to RAFT_ROOT or absolute).
RAFT_BACKUP_EXTRA="packages/server/.env packages/trace-upload-worker/.env ops/self-host/env.local"
